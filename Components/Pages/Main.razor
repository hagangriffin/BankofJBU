@page "/Main"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using BlazorServerApp.Data
@using BlazorServerApp.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<BankingDbContext> DbFactory

<PageTitle>Personal Account</PageTitle>

<h1>Personal Account</h1>

@if (!isLoggedIn)
{
    <div class="card" style="max-width: 28rem;">
        <div class="card-body">
            <h2 class="card-title">Login</h2>
            <p class="text-muted">Use the sample credentials: <strong>username</strong> / <strong>password</strong></p>

            <EditForm Model="loginModel" OnValidSubmit="Login">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <InputText id="username" class="form-control" @bind-Value="loginModel.Username" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                </div>

                <button class="btn btn-primary" type="submit">Login</button>
            </EditForm>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Welcome, @loginModel.Username</h2>
        <button class="btn btn-outline-secondary" @onclick="Logout">Log Out</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(notificationMessage))
    {
        <div class="alert alert-info" role="alert">@notificationMessage</div>
    }

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">Account Actions</h3>
                    <p class="display-6">@client.Balance.ToString("C")</p>
                    <p><strong>@client.FullName</strong><br />@client.Email</p>

                    <div class="mb-3">
                        <label class="form-label" for="amount">Amount</label>
                        <InputNumber id="amount" class="form-control" @bind-Value="amount" />
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-success" @onclick="Deposit">Deposit</button>
                        <button class="btn btn-warning" @onclick="Withdraw">Withdraw</button>
                        <div class="form-check d-flex align-items-center ms-2">
                            <input id="showStatement" class="form-check-input me-2" type="checkbox" @bind="statementVisible" />
                            <label class="form-check-label" for="showStatement">Show Statement</label>
                        </div>
                    </div>

                    @if (statementVisible)
                    {
                        <hr />
                        <h4>Account Statement</h4>
                        @if (!transactions.Any())
                        {
                            <p>No transactions yet.</p>
                        }
                        else
                        {
                            <dl>
                                <dt>Total deposits</dt>
                                <dd>@transactions.Where(t => t.Type == "Deposit").Sum(t => t.Amount).ToString("C")</dd>
                                <dt>Total withdrawals</dt>
                                <dd>@transactions.Where(t => t.Type == "Withdrawal").Sum(t => t.Amount).ToString("C")</dd>
                            </dl>
                        }
                        <p><strong>Current balance:</strong> @client.Balance.ToString("C")</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <TransactionList Transactions="transactions" />
        </div>
    </div>
}

@code {
    private readonly LoginModel loginModel = new();
    private Client client = null!;
    private List<Transaction> transactions = new();
    private decimal amount;
    private bool isLoggedIn;
    private bool statementVisible;
    private string? notificationMessage;

    private async Task Login()
    {
        await using var database = await DbFactory.CreateDbContextAsync();
        var storedClient = await database.Clients
            .Include(value => value.Transactions)
            .SingleOrDefaultAsync(value => value.Username == loginModel.Username);

        if (storedClient is null || storedClient.Password != loginModel.Password)
        {
            notificationMessage = "Login failed.";
            loginModel.Password = string.Empty;
            return;
        }

        client = storedClient;
        transactions = client.Transactions.OrderByDescending(value => value.CreatedUtc).ToList();
        isLoggedIn = true;
        notificationMessage = "Login successful.";
        loginModel.Password = string.Empty;
    }

    private void Logout()
    {
        isLoggedIn = false;
        statementVisible = false;
        client = null!;
        transactions.Clear();
        notificationMessage = "Logged out.";
    }

    private async Task Deposit()
    {
        if (amount <= 0)
        {
            notificationMessage = "Invalid amount. It must be greater than zero.";
            amount = 0;
            return;
        }

        await RecordTransaction("Deposit", amount, client.Balance + amount);
        amount = 0;
    }

    private async Task Withdraw()
    {
        if (amount <= 0)
        {
            notificationMessage = "Invalid amount. It must be greater than zero.";
        }
        else if (amount > client.Balance)
        {
            notificationMessage = "Insufficient funds.";
        }
        else
        {
            await RecordTransaction("Withdrawal", amount, client.Balance - amount);
        }

        amount = 0;
    }

    private async Task RecordTransaction(string type, decimal transactionAmount, decimal newBalance)
    {
        await using var database = await DbFactory.CreateDbContextAsync();
        var databaseClient = await database.Clients.FindAsync(client.Id);

        if (databaseClient is null)
        {
            isLoggedIn = false;
            notificationMessage = "The client account could not be found.";
            return;
        }

        databaseClient.Balance = newBalance;
        database.Transactions.Add(new Transaction
        {
            ClientId = client.Id,
            Type = type,
            Amount = transactionAmount,
            CreatedUtc = DateTime.UtcNow
        });
        await database.SaveChangesAsync();

        client.Balance = newBalance;
        transactions = await database.Transactions
            .Where(value => value.ClientId == client.Id)
            .OrderByDescending(value => value.CreatedUtc)
            .ToListAsync();
        notificationMessage = $"{type} of {transactionAmount:C} successful. New balance: {newBalance:C}";
    }

    private sealed class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
